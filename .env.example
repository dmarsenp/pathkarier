# Salin ke .env.local lalu isi. JANGAN commit nilai asli.

# Database MySQL / TiDB Cloud (kompatibel MySQL). Pilih wilayah yang sama dengan region function Vercel.
# TiDB Cloud wajib SSL: tambahkan sslaccept=strict. connection_limit kecil agar tidak menghabiskan koneksi di serverless.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict&connection_limit=3"

NEXTAUTH_SECRET="string-acak-panjang"
NEXTAUTH_URL="http://localhost:3000"

# ---- AI (explanation layer). Isi minimal satu. Dicoba berurutan sampai ada yang berhasil. ----
GEMINI_API_KEY=""
# Opsional: daftar model Gemini (pisahkan koma). Default: gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_MODELS=""

# Cadangan lintas penyedia (opsional, dilewati bila kosong):
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Urutan penyedia dan batas waktu (opsional)
LLM_PROVIDER_ORDER="gemini,groq,openrouter,openai"
LLM_TIMEOUT_MS=20000
LLM_TOTAL_BUDGET_MS=50000
